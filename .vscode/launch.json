{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Local Listener",
      "type": "debugpy",
      "request": "launch",
      "module": "ohunerin",
      "args": [
        "listen",
        "--host",
        "localhost",
        "--port",
        "45023",
        "--mqtt-broker",
        "localhost",
        "--mqtt-port",
        "41883",
        "--threshold",
        "0.1",
        "--features-file",
        "features.json"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Container Listener",
      "type": "debugpy",
      "request": "launch",
      "module": "ohunerin",
      "args": [
        "listen",
        "--host",
        "detector",
        "--port",
        "5023",
        "--mqtt-broker",
        "mosquitto",
        "--mqtt-port",
        "1883",
        "--threshold",
        "0.1",
        "--features-file",
        "features.json"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}