{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Listener",
      "type": "debugpy",
      "request": "launch",
      "module": "ohunerin",
      "args": [
        "listen",
        "--host",
        "detector",
        "--port",
        "5023",
        "--mqtt-broker",
        "mosquitto",
        "--mqtt-port",
        "1883",
        "--threshold",
        "0.1"
      ],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
